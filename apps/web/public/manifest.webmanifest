{
  "name": "Notak",
  "short_name": "Notak",
  "description": "Des tableaux d'idées : notes, images, liens, listes, sur une toile libre.",
  "lang": "fr",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#eef0f2",
  "theme_color": "#2f6feb",
  "icons": [
    { "src": "/icones/192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icones/512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icones/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icones/icone.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Note rapide",
      "short_name": "Note rapide",
      "description": "Jeter une idée dans les non triés",
      "url": "/rapide",
      "icons": [{ "src": "/icones/192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": { "application/x-notak": [".notak"] }
    }
  ],
  "share_target": {
    "action": "/partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titre",
      "text": "texte",
      "url": "adresse",
      "files": [{ "name": "images", "accept": ["image/*"] }]
    }
  }
}
