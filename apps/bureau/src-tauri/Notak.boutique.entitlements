<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Les droits de Notak pour Mac quand il passe par TestFlight et le Mac App Store (tauri.boutique.json, docs/LIVRER.md).
  Apple exige le cloisonnement ; on n'ouvre que ce dont Notak se sert :
    - le réseau en sortie : un serveur Notak choisi, les lecteurs intégrés, OpenStreetMap ;
    - les fichiers que la personne choisit (Enregistrer sous, ⌘S, Importer, un .notak ouvert du Finder) ;
    - le micro, pour les notes audio (la phrase est dans Info.plist) ;
    - le dossier iCloud de Notak, le même conteneur que sur l'iPhone et l'iPad (src/nuage.rs).
  Le profil embarqué (`scripts/livrer.ts profil`) doit porter les mêmes ; l'équipe est Silak.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.application-identifier</key>
	<string>2MLG399MFA.app.notak.bureau</string>
	<key>com.apple.developer.team-identifier</key>
	<string>2MLG399MFA</string>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.notak.bureau</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.app.notak.bureau</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
</dict>
</plist>
