{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notak",
  "version": "0.1.0",
  "identifier": "app.notak.bureau",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "http://localhost:3005"
  },
  "app": {
    "windows": [
      {
        "label": "principale",
        "title": "Notak",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 13, "y": 21 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Des tableaux d'idées sur une toile libre.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
