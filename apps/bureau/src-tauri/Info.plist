<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ajouté par Tauri à l'Info.plist de Notak.app. Sans la phrase du micro, macOS arrête l'app à la première note audio d'une carte. -->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Notak enregistre une note audio quand vous le lui demandez, dans une carte mentale. Le son reste sur votre ordinateur.</string>
  <!-- Rien d'autre que le HTTPS du système : TestFlight et l'App Store ne demandent pas le questionnaire d'export à chaque build. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <!-- Le schéma notak : un lien notak://<serveur>/<chemin> cliqué ailleurs (une fiche de Silak) ouvre sa page dans
       Notak, si Notak est relié à ce serveur (src/lien.rs). -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>app.notak.bureau</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>notak</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
