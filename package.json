{
  "name": "notak",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:locale": "VITE_EDITION=locale bun run --cwd apps/web dev",
    "serveur": "node apps/serveur/src/index.ts",
    "serveur:chiffrer": "node apps/serveur/outils/chiffrer.ts",
    "build": "bun run --cwd apps/web build",
    "build:locale": "VITE_EDITION=locale bun run --cwd apps/web build",
    "build:bureau": "VITE_EDITION=locale bun run --cwd apps/web build --outDir dist-bureau",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p apps/serveur",
    "serveur:compte": "node apps/serveur/src/compte.ts",
    "signalements": "node apps/serveur/outils/signalements.ts",
    "bureau:dev": "cd apps/bureau/src-tauri && bunx @tauri-apps/cli@2.12.4 dev",
    "bureau:construire": "node scripts/bureau.ts construire",
    "bureau:cle": "node scripts/bureau.ts cle",
    "nouvelle-version": "node scripts/nouvelle-version.ts",
    "ios:init": "node scripts/ios.ts init",
    "ios:dev": "node scripts/ios.ts dev",
    "ios:construire": "node scripts/ios.ts construire"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "jsdom": "^27.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
