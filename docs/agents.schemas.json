          },
          "groupes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "description": "",
              "properties": {
                "titre": {
                  "type": "string",
                  "maxLength": 200
                },
                "elements": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "L’identifiant d’un élément, tel que `lire_tableau` le rend."
                  },
                  "minItems": 1,
                  "maxItems": 200
                },
                "en_colonne": {
                  "type": "boolean",
                  "description": "Range le groupe dans une colonne (créée, ou celle qui porte déjà ce titre)."
                },
                "couleur": {
                  "type": "string",
                  "enum": [
                    "gris",
                    "cyan",
                    "vert",
                    "brun",
                    "jaune",
                    "orange",
                    "rouge",
                    "rose",
                    "violet",
                    "bleu",
                    "bleu_nuit"
                  ],
                  "description": "Une couleur de la palette des notes."
                }
              },
              "required": [
                "elements"
