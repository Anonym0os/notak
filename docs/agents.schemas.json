              },
              "taches": {
                "type": "array",
                "maxItems": 200,
                "description": "Les tâches, dans l’ordre.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "texte": {
                      "type": "string",
                      "minLength": 1,
