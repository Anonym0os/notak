                  "gris",
                  "cyan",
                  "vert",
                  "brun",
                  "jaune",
                  "orange",
                  "rouge",
                  "rose",
                  "violet",
                  "bleu",
                  "bleu_nuit"
                ],
                "description": "Une couleur de la palette des notes."
              },
              "url": {
                "type": "string",
                "maxLength": 2000,
                "description": "lien : l’adresse, en http(s)."
              },
              "taches": {
                "type": "array",
                "maxItems": 200,
                "description": "Les tâches, dans l’ordre.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "texte": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "faite": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "texte"
                  ]
                }
              },
              "lignes": {
                "type": "array",
