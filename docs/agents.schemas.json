{
  "version": 1,
  "route": "POST /api/outils/{source}/agent",
  "signature": "Notak-Signature: t=<secondes>,v1=<hex de HMAC-SHA256(secret, \"<t>.<corps>\")>",
  "corps_max": 524288,
  "demande": {
    "type": "object",
    "additionalProperties": false,
    "description": "Une demande d’un agent, signée du secret de son outil.",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$",
        "description": "Unique par demande : la même renvoyée rend la même réponse, sans rien refaire."
      },
      "au_nom_de": {
        "type": "object",
        "additionalProperties": false,
        "description": "La personne pour qui l’agent agit : son identifiant chez l’outil (le sujet de son compte lié par le SSO), sinon son courriel vérifié.",
        "properties": {
          "sujet": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "courriel": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320
          }
        }
      },
      "operation": {
        "type": "string",
        "enum": [
          "trouver",
          "lire_tableau",
          "creer_tableau",
          "ajouter_elements",
          "modifier_elements",
          "ranger",
          "jeter_elements",
          "remettre_elements"
        ]
      },
      "arguments": {
        "type": "object"
      }
    },
    "required": [
      "id",
      "au_nom_de",
      "operation"
    ]
  },
  "operations": {
    "trouver": {
      "description": "Trouve où travailler. Sans argument : les espaces de la personne (et leur accueil) et ses tableaux récents. `texte` cherche dans les titres et dans le contenu de tous les tableaux qu’elle lit. `dans` liste ce que range un tableau ou un dossier. `fiche` rend le dossier d’une fiche de l’outil par sa clé de rattachement (societe:42).",
      "ecrit": false,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "description": "",
        "properties": {
          "texte": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "dans": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$",
            "description": "L’identifiant d’un tableau (ou d’un dossier), tel que `trouver` ou `lire_tableau` le rendent."
          },
          "fiche": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,127}$"
          },
          "limite": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Combien de résultats au plus (20 par défaut)."
          }
        }
      }
    },
    "lire_tableau": {
      "description": "Lit un tableau : chaque élément avec son type, son texte lisible, sa place et sa taille en unités de grille, sa colonne ; les cartes mentales en plan imbriqué, les tables en lignes. `structure` décrit la mise en page : les zones (groupes d’éléments proches), les chevauchements, et une place libre où poser du neuf. Relis le tableau avant de modifier ou de ranger.",
      "ecrit": false,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "description": "",
        "properties": {
          "tableau": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$",
            "description": "L’identifiant d’un tableau (ou d’un dossier), tel que `trouver` ou `lire_tableau` le rendent."
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "L’identifiant d’un élément, tel que `lire_tableau` le rend."
            },
            "minItems": 1,
            "maxItems": 200,
            "description": "Seulement ces éléments (et ce que rangent leurs colonnes)."
          },
          "corbeille": {
            "type": "boolean",
            "description": "Inclure les éléments jetés à la corbeille du tableau."
          }
        },
        "required": [
          "tableau"
        ]
      }
    },
    "creer_tableau": {
      "description": "Crée un tableau (une toile vide), dans un tableau ou un dossier (`dans`), dans le dossier d’une fiche de l’outil (`fiche`), ou à défaut dans l’accueil de l’espace personnel. Sa carte y est posée, il en hérite les accès. Rend son identifiant.",
      "ecrit": true,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "description": "",
        "properties": {
          "titre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "dans": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$",
            "description": "L’identifiant d’un tableau (ou d’un dossier), tel que `trouver` ou `lire_tableau` le rendent."
          },
          "fiche": {
            "type": "object",
            "additionalProperties": false,
            "description": "Le dossier d’une fiche de l’outil, créé s’il manque et que `titre` est donné.",
            "properties": {
              "cle": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,127}$"
              },
              "titre": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Le titre du dossier de la fiche, s’il faut le créer (le nom du client)."
              }
            },
            "required": [
              "cle"
            ]
          },
          "couleur": {
            "type": "string",
            "enum": [
              "gris",
              "cyan",
              "vert",
              "brun",
              "jaune",
              "orange",
              "rouge",
              "rose",
              "violet",
              "bleu",
              "bleu_nuit"
            ],
            "description": "Une couleur de la palette des notes."
          },
          "dossier": {
            "type": "boolean",
            "description": "Le tableau se montre en dossier dans la bibliothèque."
          }
        },
        "required": [
          "titre"
        ]
      }
    },
    "ajouter_elements": {
      "description": "Pose des éléments sur un tableau, exactement comme les crée l’app : notes, titres, listes de tâches, liens, colonnes avec leur contenu, tables, cartes mentales depuis un plan imbriqué. Placement : `place.pres_de` (à côté d’un élément), `place.dans_colonne` (au bout d’une colonne), `place.x`/`place.y`, ou à défaut dans une place libre. Jamais par-dessus un autre élément. Plusieurs éléments se rangent de gauche à droite (`disposition`).",
      "ecrit": true,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "description": "",
        "properties": {
          "tableau": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$",
            "description": "L’identifiant d’un tableau (ou d’un dossier), tel que `trouver` ou `lire_tableau` le rendent."
          },
          "elements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "items": {
              "$ref": "#/$defs/element"
            }
          },
          "place": {
            "type": "object",
            "additionalProperties": false,
            "description": "Où poser les éléments ; absente : dans une place libre, à droite de ce qui est là.",
            "properties": {
              "pres_de": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "L’identifiant d’un élément, tel que `lire_tableau` le rend."
              },
              "cote": {
                "type": "string",
                "enum": [
                  "droite",
                  "dessous",
                  "gauche",
                  "dessus"
                ],
                "description": "Avec `pres_de` ; à droite par défaut."
              },
              "dans_colonne": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "L’identifiant d’un élément, tel que `lire_tableau` le rend."
              },
              "x": {
                "type": "integer",
                "minimum": -15000,
                "maximum": 15000
              },
              "y": {
                "type": "integer",
                "minimum": -15000,
                "maximum": 15000
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "ligne",
                  "pile",
                  "grille"
                ],
                "description": "ligne : côte à côte (par défaut). pile : les uns sous les autres. grille : en rangées."
              }
            }
          }
        },
        "required": [
          "tableau",
          "elements"
        ],
        "$defs": {
          "branche": {
            "type": "object",
            "additionalProperties": false,
            "description": "Une branche d’une carte mentale : son titre, court (quelques mots), et ses sous-branches.",
            "properties": {
              "titre": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "note": {
                "type": "string",
                "maxLength": 4000,
                "description": "Une note sous le sujet (texte simple), pour le détail qui n’a pas sa place dans le titre."
              },
              "enfants": {
                "type": "array",
                "maxItems": 40,
                "items": {
                  "$ref": "#/$defs/branche"
                }
              }
            },
            "required": [
              "titre"
            ]
          },
          "element": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "note",
                  "titre",
                  "taches",
                  "lien",
                  "colonne",
                  "table",
                  "carte_mentale"
                ],
                "description": "note : un texte (Markdown simple : titres #, listes -, gras **, italique _, liens). titre : un titre posé sur la toile, sans fond. taches : une liste de cases à cocher. lien : une adresse web, avec son aperçu. colonne : une colonne qui range des éléments. table : un petit tableur. carte_mentale : une carte mentale, depuis un plan imbriqué."
              },
              "texte": {
                "type": "string",
                "maxLength": 20000,
                "description": "note, titre : le texte, en Markdown simple."
              },
              "titre": {
                "type": "string",
                "maxLength": 300,
                "description": "taches, colonne, table, lien : le titre."
              },
              "couleur": {
                "type": "string",
