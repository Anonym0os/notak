    "modifier_elements": {
      "description": "Modifie des éléments : le texte d’une note ou d’un titre (Markdown simple), un titre, une couleur, les tâches d’une liste (les remplacer, ou en cocher), les lignes d’une table, les branches d’une carte mentale. Ce qui n’est pas donné ne change pas.",
      "ecrit": true,
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "description": "",
        "properties": {
          "tableau": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$",
